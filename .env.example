# Express server port
PORT=3000

# Qwen API configuration (leave empty to use mock mode)
DASHSCOPE_API_KEY=<your-api-key>
DASHSCOPE_API_URL=baseURL

# Model for decision generation (default: qwen3.5-flash)
DECISION_MODEL=qwen3.5-flash

# Model for deep simulation (default: qwen3.5-flash)
SIMULATE_MODEL=qwen3.5-flash

# Set to 'true' to enable real LLM calls (falls back to mock if API fails)
USE_REAL_LLM=true
